# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_string

git remote set-url origin https://github.com/megaton20/tem-enterprise.git

# Database (Postgres)
# Option A - Neon (or any hosted Postgres that gives you a connection
# string): set DATABASE_URL and leave it set. Get this from your Neon
# project dashboard -> Connection Details. Overrides everything below.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/tem_store?sslmode=require

# Option B - local Postgres: used automatically whenever DATABASE_URL
# above is commented out / unset.
DB_NAME=tem_store
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Delivery
DEFAULT_HOME_DELIVERY_FEE=1500

# Brevo (transactional email)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=orders@temstore.com
BREVO_SENDER_NAME=TEM Store
ADMIN_NOTIFICATION_EMAIL=admin@temstore.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Riders
RIDER_PAYOUT_PERCENT=60
