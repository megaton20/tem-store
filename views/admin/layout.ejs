<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin — TEM Store' %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen bg-dough/30 text-cocoa font-body">
  <div class="flex min-h-screen">
    <aside class="w-64 bg-cocoa text-cream flex-shrink-0 hidden md:flex md:flex-col">
      <div class="px-6 py-5 border-b border-cream/10">
        <a href="/admin" class="font-display text-xl font-bold">TEM<span class="text-caramel">Admin</span></a>
        <p class="text-xs text-cream/50 mt-1"><%= currentUser.fullName %> &middot; <%= currentUser.role.replace(/_/g, ' ') %></p>
        <a href="/admin/docs/<%= currentUser.role %>" class="text-xs text-caramel hover:text-caramel-dark mt-1 inline-block">Read your Role Guide &rarr;</a>
      </div>
      <nav class="flex-1 px-3 py-4 space-y-1 text-sm" id="admin-nav">
        <% (typeof roleNav !== 'undefined' ? roleNav : []).forEach(function(item) { %>
          <a href="<%= item.href %>" data-skeleton="<%= item.skeleton || 'table' %>" class="skeleton-link block px-3 py-2 rounded-lg hover:bg-cream/10"><%= item.label %></a>
        <% }); %>
      </nav>
      <div class="px-3 py-4 border-t border-cream/10 space-y-1">
        <a href="/admin/profile" data-skeleton="form" class="skeleton-link block px-3 py-2 rounded-lg hover:bg-cream/10 text-sm text-cream/70">My Profile</a>
        <a href="/" class="block px-3 py-2 rounded-lg hover:bg-cream/10 text-sm text-cream/70">&larr; Back to Storefront</a>
        <form action="/logout" method="POST">
          <button type="submit" class="w-full text-left px-3 py-2 rounded-lg hover:bg-cream/10 text-sm text-cream/70">Log out</button>
        </form>
      </div>
    </aside>

    <main class="flex-1 min-w-0 relative">
      <header class="md:hidden bg-cocoa text-cream px-4 py-3 flex items-center justify-between">
        <span class="font-display font-bold">TEM<span class="text-caramel">Admin</span></span>
        <a href="/admin" class="text-sm text-cream/70">Menu</a>
      </header>

      <!-- Skeleton overlay: one variant per page layout shape, toggled by JS
           on nav-link click so navigation feels immediate even on a slow
           connection. Hidden by default; only the matching variant shows. -->
      <div id="skeleton-overlay" class="hidden absolute inset-0 z-40 bg-dough/30 p-6 sm:p-8 overflow-y-auto">

        <div data-variant="dashboard" class="hidden">
          <div class="shimmer h-7 w-48 rounded-lg mb-6"></div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 mb-8">
            <% for (let i=0;i<4;i++) { %>
              <div class="card p-5"><div class="shimmer h-3 w-20 rounded mb-3"></div><div class="shimmer h-7 w-12 rounded"></div></div>
            <% } %>
          </div>
          <div class="card p-6">
            <div class="shimmer h-5 w-40 rounded mb-4"></div>
            <% for (let i=0;i<4;i++) { %><div class="shimmer h-4 w-full rounded mb-3"></div><% } %>
          </div>
        </div>

        <div data-variant="table" class="hidden">
          <div class="flex items-center justify-between mb-6">
            <div class="shimmer h-7 w-40 rounded-lg"></div>
            <div class="shimmer h-9 w-32 rounded-full"></div>
          </div>
          <div class="card overflow-hidden">
            <div class="shimmer h-10 w-full"></div>
            <% for (let i=0;i<7;i++) { %>
              <div class="flex items-center gap-4 px-4 py-3 border-t border-dough/60">
                <div class="shimmer h-4 w-1/4 rounded"></div>
                <div class="shimmer h-4 w-1/6 rounded"></div>
                <div class="shimmer h-4 w-1/6 rounded"></div>
                <div class="shimmer h-4 w-1/6 rounded ml-auto"></div>
              </div>
            <% } %>
          </div>
        </div>

        <div data-variant="cards" class="hidden">
          <div class="shimmer h-7 w-40 rounded-lg mb-6"></div>
          <div class="grid sm:grid-cols-2 gap-4">
            <% for (let i=0;i<6;i++) { %>
              <div class="card p-5">
                <div class="shimmer h-4 w-2/3 rounded mb-3"></div>
                <div class="shimmer h-3 w-full rounded mb-2"></div>
                <div class="shimmer h-3 w-4/5 rounded"></div>
              </div>
            <% } %>
          </div>
        </div>

        <div data-variant="form" class="hidden max-w-lg">
          <div class="shimmer h-7 w-48 rounded-lg mb-6"></div>
          <div class="card p-6 space-y-4">
            <% for (let i=0;i<5;i++) { %>
              <div>
                <div class="shimmer h-3 w-24 rounded mb-2"></div>
                <div class="shimmer h-10 w-full rounded-xl"></div>
              </div>
            <% } %>
            <div class="shimmer h-11 w-full rounded-full mt-2"></div>
          </div>
        </div>

        <div data-variant="pos" class="hidden">
          <div class="shimmer h-7 w-40 rounded-lg mb-6"></div>
          <div class="grid lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 grid grid-cols-2 sm:grid-cols-3 gap-4">
              <% for (let i=0;i<6;i++) { %>
                <div class="card p-3">
                  <div class="shimmer aspect-square rounded-lg mb-2"></div>
                  <div class="shimmer h-3 w-3/4 rounded mb-2"></div>
                  <div class="shimmer h-3 w-1/2 rounded"></div>
                </div>
              <% } %>
            </div>
            <div class="card p-6">
              <div class="shimmer h-5 w-32 rounded mb-4"></div>
              <div class="shimmer h-4 w-full rounded mb-2"></div>
              <div class="shimmer h-4 w-full rounded mb-6"></div>
              <div class="shimmer h-11 w-full rounded-full"></div>
            </div>
          </div>
        </div>

      </div>

      <div class="p-6 sm:p-8" id="admin-content">
        <% if (typeof flashError !== 'undefined' && flashError) { %>
          <div class="bg-caramel-dark/10 border border-caramel-dark/30 text-caramel-dark rounded-xl px-4 py-3 mb-6 text-sm"><%= flashError %></div>
        <% } %>
        <%- body %>
      </div>
    </main>
  </div>

  <script>
    // Shows the matching skeleton variant, then lets the click/submit
    // proceed as normal - the overlay just covers the gap between click
    // and the next page actually painting, so navigation feels instant
    // even on a slow branch connection.
    //
    // Three things that were broken before:
    // 1. It showed instantly, so a fast (local) navigation caused a jarring
    //    flash of the loader for a split second - now it waits 150ms first,
    //    so quick loads never show it at all.
    // 2. There was no upper bound - if a request ever hung (bad connection,
    //    server stall), the overlay stayed up forever with no explanation.
    //    Now it auto-hides after 10s and shows a short note instead of
    //    silently sitting there.
    // 3. Pressing the browser Back button after a skeleton was shown could
    //    restore the page from cache with the overlay still visible, since
    //    nothing ever told it to hide again. `pageshow` fixes that.
    let skeletonShowTimer = null;
    let skeletonSafetyTimer = null;

    function showSkeleton(variant) {
      clearTimeout(skeletonShowTimer);
      skeletonShowTimer = setTimeout(() => {
        const overlay = document.getElementById('skeleton-overlay');
        overlay.querySelectorAll('[data-variant]').forEach((el) => el.classList.add('hidden'));
        const match = overlay.querySelector('[data-variant="' + variant + '"]') || overlay.querySelector('[data-variant="table"]');
        match.classList.remove('hidden');
        overlay.classList.remove('hidden');

        clearTimeout(skeletonSafetyTimer);
        skeletonSafetyTimer = setTimeout(() => {
          let note = overlay.querySelector('#skeleton-slow-note');
          if (!note) {
            note = document.createElement('p');
            note.id = 'skeleton-slow-note';
            note.className = 'text-sm text-cocoa-light text-center mt-6';
            note.textContent = 'This is taking longer than usual — check your connection.';
            overlay.appendChild(note);
          }
        }, 10000);
      }, 150);
    }

    function hideSkeleton() {
      clearTimeout(skeletonShowTimer);
      clearTimeout(skeletonSafetyTimer);
      const overlay = document.getElementById('skeleton-overlay');
      overlay.classList.add('hidden');
      const note = overlay.querySelector('#skeleton-slow-note');
      if (note) note.remove();
    }

    document.querySelectorAll('.skeleton-link').forEach((link) => {
      link.addEventListener('click', function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return; // let "open in new tab" alone
        showSkeleton(this.dataset.skeleton || 'table');
      });
    });

    // Also cover POST-form navigations that redirect to a new page (e.g.
    // "Add Product" style forms that aren't modals) - same table skeleton
    // by default since most of those land back on a list page.
    document.querySelectorAll('form[data-skeleton-on-submit]').forEach((form) => {
      form.addEventListener('submit', function () {
        showSkeleton(this.dataset.skeletonOnSubmit);
      });
    });

    // A page restored from the back/forward cache is a page that never
    // actually reloaded - if a skeleton was showing when the person
    // navigated away, this is what clears it.
    window.addEventListener('pageshow', hideSkeleton);
  </script>
</body>
</html>
