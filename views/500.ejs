<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Something Went Wrong — TEM Store</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen flex items-center justify-center bg-cream text-cocoa px-6">
  <div class="text-center max-w-md">
    <p class="text-6xl font-bold text-caramel">500</p>
    <p class="mt-4 text-cocoa-light">Something went wrong on our end. Please try again in a moment.</p>
    <a href="/" class="btn-primary inline-flex mt-8">Back to TEM Store</a>
    <% if (typeof error !== 'undefined' && error) { %>
      <pre class="text-left text-xs bg-dough/40 rounded-lg p-4 mt-8 overflow-auto"><%= error.stack %></pre>
    <% } %>
  </div>
</body>
</html>
