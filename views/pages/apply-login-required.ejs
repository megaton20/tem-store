<section class="max-w-lg mx-auto px-5 sm:px-8 py-20 text-center">
  <span class="text-4xl">🔒</span>
  <h1 class="text-3xl font-bold text-cocoa mt-4 mb-2">Log In to Apply</h1>
  <p class="text-cocoa-light">A <%= channel %> application uses your TEM Store account, so we know exactly who's applying. Log in or create an account to continue.</p>
  <div class="flex items-center justify-center gap-3 mt-8">
    <a href="/login?next=<%= encodeURIComponent(applyPath) %>" class="btn-primary">Log In</a>
    <a href="/register?next=<%= encodeURIComponent(applyPath) %>" class="btn-secondary">Create Account</a>
  </div>
</section>
