<header class="sticky top-0 z-40 bg-cream/90 backdrop-blur border-b border-dough">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="font-display text-2xl font-bold text-cocoa tracking-tight">TEM<span class="text-caramel">Store</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-cocoa-light">
      <a href="/" class="hover:text-cocoa transition-colors">Home</a>
      <a href="/shop?category=cookies" class="hover:text-cocoa transition-colors">Second Nature Cookies</a>
      <a href="/shop" class="hover:text-cocoa transition-colors">Shop All</a>
      <a href="/about" class="hover:text-cocoa transition-colors">About</a>
      <a href="/contact" class="hover:text-cocoa transition-colors">Contact</a>
    </nav>

    <div class="flex items-center gap-4">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/orders" class="hidden sm:inline text-sm font-medium text-cocoa-light hover:text-cocoa">My Orders</a>
        <a href="/profile" class="hidden sm:inline text-sm font-medium text-cocoa-light hover:text-cocoa">Profile</a>
        <form action="/logout" method="POST" class="hidden sm:block">
          <button type="submit" class="text-sm font-medium text-cocoa-light hover:text-cocoa">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="hidden sm:inline text-sm font-medium text-cocoa-light hover:text-cocoa">Log in</a>
      <% } %>

      <a href="/cart" class="relative flex items-center justify-center w-10 h-10 rounded-full bg-cocoa text-cream hover:bg-cocoa-light transition-colors" aria-label="Cart">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l3.6-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <% if (typeof cartItemCount !== 'undefined' && cartItemCount > 0) { %>
          <span id="cart-count-badge" class="absolute -top-1 -right-1 bg-caramel text-cream text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center"><%= cartItemCount %></span>
        <% } else { %>
          <span id="cart-count-badge" class="hidden absolute -top-1 -right-1 bg-caramel text-cream text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
        <% } %>
      </a>
    </div>
  </div>
</header>
