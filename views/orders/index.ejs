<section class="max-w-4xl mx-auto px-5 sm:px-8 py-12">
  <h1 class="text-3xl font-bold text-cocoa mb-8">Your Orders</h1>

  <% if (!orders.length) { %>
    <div class="card p-10 text-center">
      <p class="text-cocoa-light">You haven't placed an order yet.</p>
      <a href="/shop" class="btn-primary inline-flex mt-6">Start Shopping</a>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% orders.forEach(function(order) { %>
        <a href="/orders/<%= order.id %>" class="card p-5 flex items-center justify-between hover:shadow-md transition-shadow">
          <div>
            <p class="font-semibold text-cocoa"><%= order.orderNumber %></p>
            <p class="text-sm text-cocoa-light"><%= new Date(order.createdAt).toLocaleDateString() %> &middot; <%= order.deliveryMethod === 'pickup' ? 'Pickup' : 'Home Delivery' %></p>
          </div>
          <div class="text-right">
            <p class="font-bold text-cocoa">&#8358;<%= Number(order.total).toLocaleString() %></p>
            <span class="text-xs font-semibold uppercase tracking-wide <%= order.status === 'paid' || order.status === 'completed' ? 'text-forest' : 'text-caramel-dark' %>"><%= order.status.replace(/_/g, ' ') %></span>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</section>
