<section class="max-w-lg mx-auto px-5 sm:px-8 py-16">
  <h1 class="text-3xl font-bold text-cocoa mb-2">Create your account</h1>
  <p class="text-cocoa-light mb-8">We just need a few details so we know who's placing the order — and where to send it.</p>

  <% if (errors && errors.length) { %>
    <div class="bg-caramel-dark/10 border border-caramel-dark/30 text-caramel-dark rounded-xl px-4 py-3 mb-6 text-sm">
      <ul class="list-disc list-inside space-y-1">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/register" method="POST" class="space-y-4">
    <input type="hidden" name="next" value="<%= next %>">

    <div>
      <label class="block text-sm font-medium text-cocoa mb-2">Full Name</label>
      <input type="text" name="fullName" required value="<%= old.fullName || '' %>" class="input-field" placeholder="Jane Doe">
    </div>
    <div>
      <label class="block text-sm font-medium text-cocoa mb-2">Email</label>
      <input type="email" name="email" required value="<%= old.email || '' %>" class="input-field" placeholder="you@example.com">
    </div>
    <div>
      <label class="block text-sm font-medium text-cocoa mb-2">Phone Number</label>
      <input type="text" name="phone" required value="<%= old.phone || '' %>" class="input-field" placeholder="080XXXXXXXX">
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-cocoa mb-2">Password</label>
        <input type="password" name="password" required class="input-field" placeholder="••••••••">
      </div>
      <div>
        <label class="block text-sm font-medium text-cocoa mb-2">Confirm Password</label>
        <input type="password" name="confirmPassword" required class="input-field" placeholder="••••••••">
      </div>
    </div>

    <div class="border-t border-dough pt-4 mt-2">
      <p class="text-sm text-cocoa-light mb-3">Optional — saves time if you plan to have things delivered.</p>
      <div>
        <label class="block text-sm font-medium text-cocoa mb-2">Address</label>
        <input type="text" name="address" value="<%= old.address || '' %>" class="input-field" placeholder="Street address">
      </div>
      <div class="grid grid-cols-2 gap-4 mt-4">
        <div>
          <label class="block text-sm font-medium text-cocoa mb-2">State</label>
          <select id="reg-state" onchange="regPopulateCities()" class="input-field">
            <option value="">Select a state</option>
            <% states.forEach(function(s) { %><option value="<%= s %>" <%= (old.state || 'Cross River') === s ? 'selected' : '' %>><%= s %></option><% }); %>
          </select>
          <input type="hidden" name="state" id="reg-state-hidden" value="<%= old.state || 'Cross River' %>">
        </div>
        <div>
          <label class="block text-sm font-medium text-cocoa mb-2">City</label>
          <select name="city" id="reg-city" onchange="regHandleCityChange()" class="input-field">
            <option value="">Select a state first</option>
          </select>
        </div>
      </div>

      <div id="reg-other-message" class="hidden mt-3 bg-caramel/10 border border-caramel/30 rounded-xl p-4">
        <p class="text-sm text-cocoa">We don't ship to your area at the moment — we're still expanding! You can update this on your profile once we reach you.</p>
        <label class="block text-sm font-medium text-cocoa mt-3 mb-2">Tell us your city (optional)</label>
        <input type="text" name="otherLocationNote" value="<%= old.otherLocationNote || '' %>" class="input-field" placeholder="Helps us know where to expand next">
      </div>
    </div>

    <button type="submit" class="btn-primary w-full">Create Account</button>

    <script>
      const REG_LOCATIONS = <%- JSON.stringify(locationsByState) %>;

      function regPopulateCities(preselectCity) {
        const state = document.getElementById('reg-state').value;
        document.getElementById('reg-state-hidden').value = state;
        const citySelect = document.getElementById('reg-city');
        citySelect.innerHTML = '';

        const cities = REG_LOCATIONS[state] || [];
        if (!state) {
          citySelect.innerHTML = '<option value="">Select a state first</option>';
        } else {
          citySelect.innerHTML = '<option value="">Select a city</option>';
          cities.forEach(function (c) {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            citySelect.appendChild(opt);
          });
        }
        const otherOpt = document.createElement('option');
        otherOpt.value = 'Other';
        otherOpt.textContent = 'Other (not listed)';
        citySelect.appendChild(otherOpt);

        if (preselectCity) citySelect.value = preselectCity;
        regHandleCityChange();
      }

      function regHandleCityChange() {
        const isOther = document.getElementById('reg-city').value === 'Other';
        document.getElementById('reg-other-message').classList.toggle('hidden', !isOther);
      }

      regPopulateCities('<%= old.city || "" %>');
    </script>
  </form>

  <p class="text-sm text-cocoa-light mt-6 text-center">
    Already have an account? <a href="/login?next=<%= encodeURIComponent(next) %>" class="text-caramel font-semibold hover:text-caramel-dark">Log in</a>
  </p>
</section>
