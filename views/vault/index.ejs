<section class="bg-vault min-h-[70vh] pb-16">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-16">
    <% if (welcome) { %>
      <div class="bg-vault-gold/10 border border-vault-gold/30 text-vault-gold rounded-xl px-4 py-3 mb-8 text-sm">
        Welcome to the Vault — your access is active.
      </div>
    <% } %>

    <div class="flex items-center justify-between mb-10">
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-vault-gold">Members Only</span>
        <h1 class="text-3xl font-bold text-cream mt-1">The Vault</h1>
      </div>
      <p class="text-cream/50 text-sm">Access until <%= new Date(subscription.expiresAt).toLocaleDateString() %></p>
    </div>

    <% if (!products.length) { %>
      <p class="text-cream/50">Nothing in the vault yet — new pieces are added regularly.</p>
    <% } else { %>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <% products.forEach(function(product) { %>
          <div class="bg-cream/5 border border-vault-gold/20 rounded-2xl overflow-hidden">
            <div class="aspect-square bg-cream/5 flex items-center justify-center">
              <img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="w-full h-full object-contain p-6" onerror="this.src='https://via.placeholder.com/400x400/1B1B22/C9A24B?text=Vault'">
            </div>
            <div class="p-4">
              <p class="font-semibold text-cream"><%= product.name %></p>
              <p class="text-vault-gold mt-1">&#8358;<%= Number(product.price).toLocaleString() %></p>
              <form action="/cart/add" method="POST" class="mt-3">
                <input type="hidden" name="productId" value="<%= product.id %>">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-vault-gold hover:bg-vault-gold/90 text-vault font-semibold px-4 py-2 rounded-full text-sm transition-colors">Add to Cart</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
